# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Secrets and local environment variables
.env
.env.*
.env.superset

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Local generated data
data/raw/*
data/processed/*

# Keep data directories when empty
!data/raw/.gitkeep
!data/processed/.gitkeep
# Terraform local state and providers
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
!**/.terraform.lock.hcl

# Database backups
*.dump
*.backup
